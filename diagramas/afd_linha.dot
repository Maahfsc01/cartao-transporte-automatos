// AFD: Linha de ônibus
digraph afd_linha {
	bgcolor="#ffffff" fontname="DejaVu Sans" nodesep=0.30 pad=0.22 rankdir=LR ranksep=0.46 splines=polyline
	node [color="#2563eb" fillcolor="#eff6ff" fontname="DejaVu Sans" fontsize=13 penwidth=1.5 shape=circle style=filled]
	edge [arrowsize=0.65 color="#334155" fontname="DejaVu Sans" fontsize=12 penwidth=1.5]
	inicio [label="" color="#0f172a" fillcolor="#0f172a" shape=point width=0.1]
	q0
	q1
	q2
	q3
	q4
	q5
	q6
	q7 [color="#16a34a" fillcolor="#dcfce7" penwidth=2 shape=doublecircle]
	inicio -> q0 [color="#2563eb"]
	q0 -> q1 [label="1–9"]
	q1 -> q2 [label="0–9"]
	q2 -> q3 [label="0–9"]
	q3 -> q4 [label="0–9"]
	q4 -> q5 [label="−"]
	q5 -> q6 [label="1–4"]
	q6 -> q7 [label="0–9"]
	node [color="#be123c" fillcolor="#fff1f2" fontcolor="#881337" fontsize=11 shape=box style="rounded,filled"]
	qerro [label="qerro
estado de erro"]
	qerro -> qerro [label="todas as classes" color="#be123c"]
	nota [label="Para cada estado, toda classe não indicada
leva a qerro (veja a tabela completa)." color="#94a3b8" fillcolor="#f8fafc" fontsize=11 shape=note style=filled]
	edge [style=invis]
	q7 -> nota
	nota -> qerro
	edge [style=solid]
}
